{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.luzione.com/contracts/connector-revocation/v2/connector-credential-handle-v2.schema.json",
  "title": "ConnectorCredentialHandle/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["bindingId", "contractVersion", "generation", "handleDigest", "provider", "providerAccountRef", "reference", "tenantId", "version"],
  "properties": {
    "bindingId": { "type": "string", "format": "uuid" },
    "contractVersion": { "const": "ConnectorCredentialHandle/v2" },
    "generation": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "handleDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provider": { "enum": ["GOOGLE_WORKSPACE", "MICROSOFT_365", "QUICKBOOKS_ONLINE"] },
    "providerAccountRef": { "$ref": "#/$defs/StrictId" },
    "reference": { "type": "string", "minLength": 14, "maxLength": 190, "pattern": "^secret-ref:[A-Za-z0-9][A-Za-z0-9._:@/-]{2,178}$" },
    "tenantId": { "$ref": "#/$defs/StrictId" },
    "version": { "$ref": "#/$defs/StrictId" }
  },
  "$defs": {
    "StrictId": { "type": "string", "minLength": 3, "maxLength": 190, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{2,189}$" }
  }
}
