{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.luzione.com/contracts/drafts/command-envelope-v0.2-draft.1.schema.json",
  "title": "Luzione Command Envelope v0.2 draft 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "activation", "commandId", "commandType", "context", "expectedObjectVersion", "idempotencyKey", "payload", "payloadHash", "policyVersionRefs", "requestedAt", "requestedEffect", "target"],
  "properties": {
    "contractVersion": { "const": "luzione-command-envelope/v0.2-draft.1" },
    "activation": { "const": "DRAFT_ONLY" },
    "commandId": { "type": "string", "minLength": 2, "maxLength": 512 },
    "commandType": { "type": "string", "minLength": 2, "maxLength": 512 },
    "context": { "$ref": "identity-tenant-v0.2-draft.1.schema.json" },
    "expectedObjectVersion": { "type": "string", "minLength": 2, "maxLength": 512 },
    "idempotencyKey": { "type": "string", "minLength": 2, "maxLength": 512 },
    "payload": { "type": "object" },
    "payloadHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policyVersionRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 512 }
    },
    "requestedAt": { "type": "string", "format": "date-time" },
    "requestedEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectClass", "authorizationRef"],
      "properties": {
        "effectClass": { "const": "NO_EFFECT" },
        "authorizationRef": { "type": "null" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerProject", "objectType", "objectId", "objectVersion"],
      "properties": {
        "ownerProject": { "type": "string", "minLength": 2, "maxLength": 512 },
        "objectType": { "type": "string", "minLength": 2, "maxLength": 512 },
        "objectId": { "type": "string", "minLength": 2, "maxLength": 512 },
        "objectVersion": { "type": "string", "minLength": 2, "maxLength": 512 }
      }
    }
  }
}
