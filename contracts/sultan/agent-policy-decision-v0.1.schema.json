{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.luzione.com/contracts/sultan/agent-policy-decision-v0.1.schema.json",
  "title": "Luzione Sultan Agent Policy Decision v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor",
    "agent",
    "agentDefinitionVerified",
    "autonomy",
    "businessStateMutated",
    "evaluatedOnly",
    "externalEffectsAuthorized",
    "nextSafeAction",
    "policyContractVersion",
    "reasonCodes",
    "sourceContext",
    "status",
    "tenantPolicy"
  ],
  "properties": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "actorType", "tenantId"],
      "properties": {
        "actorId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "actorType": { "enum": ["agent", "service", "user"] },
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId", "agentVersion", "authorityDomain", "binding"],
      "properties": {
        "agentId": { "type": "string", "pattern": "^agent\\.[a-z0-9.-]+$" },
        "agentVersion": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
        "authorityDomain": { "enum": ["LUZIONE", "FEP", "SULTAN_INTERNAL"] },
        "binding": { "enum": ["DIRECT_CREDENTIAL", "VERCEL_WORKLOAD_DELEGATION", "UNVERIFIED"] }
      }
    },
    "agentDefinitionVerified": { "type": "boolean" },
    "autonomy": {
      "type": "object",
      "required": [
        "actionAuthorized",
        "capabilityKnown",
        "constitutionVersion",
        "decision",
        "effectiveEffectClass",
        "externalEffectsAuthorized",
        "nextSafeAction",
        "reasonCodes",
        "requiredControls"
      ],
      "properties": {
        "actionAuthorized": { "type": "boolean" },
        "capabilityKnown": { "type": "boolean" },
        "constitutionVersion": { "type": "string" },
        "decision": { "enum": ["ALLOW", "BLOCK", "REQUIRE_APPROVAL", "SIMULATE_ONLY"] },
        "effectiveEffectClass": {
          "anyOf": [{ "enum": ["A0", "A1", "A2", "A3", "A4"] }, { "type": "null" }]
        },
        "externalEffectsAuthorized": { "type": "boolean" },
        "nextSafeAction": { "type": "string" },
        "reasonCodes": { "type": "array", "items": { "type": "string" } },
        "requiredControls": { "type": "array", "items": { "type": "string" } }
      }
    },
    "businessStateMutated": { "const": false },
    "evaluatedOnly": { "const": true },
    "externalEffectsAuthorized": { "const": false },
    "nextSafeAction": { "type": "string", "minLength": 1 },
    "policyContractVersion": { "const": "luzione-sultan-agent-policy/v0.1" },
    "reasonCodes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tenantPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedByPolicy", "capabilityDecision", "policyDefinitionId", "policyVersion", "reasonCodes", "ruleMatched"],
      "properties": {
        "allowedByPolicy": { "type": "boolean" },
        "capabilityDecision": { "enum": ["ALLOW", "APPROVAL", "BLOCK"] },
        "policyDefinitionId": { "type": "string", "minLength": 1 },
        "policyVersion": { "type": "integer", "minimum": 1 },
        "reasonCodes": { "type": "array", "items": { "type": "string" } },
        "ruleMatched": { "type": "boolean" }
      }
    },
    "sourceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedCount", "freshness", "synthetic", "verification", "verifiedCount"],
      "properties": {
        "acceptedCount": { "type": "integer", "minimum": 1, "maximum": 64 },
        "freshness": { "enum": ["FRESH", "STALE", "UNKNOWN"] },
        "synthetic": { "type": "boolean" },
        "verification": { "enum": ["CANONICAL_READBACK", "SYNTHETIC_SIMULATION", "UNVERIFIED"] },
        "verifiedCount": { "type": "integer", "minimum": 0, "maximum": 64 }
      }
    },
    "status": {
      "enum": ["ABSTAIN_STALE_CONTEXT", "ADMIT_READ_ONLY", "BLOCKED", "REQUIRE_APPROVAL", "SIMULATE_ONLY"]
    }
  }
}
