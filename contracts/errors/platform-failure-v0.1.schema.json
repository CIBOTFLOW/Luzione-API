{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.luzione.com/contracts/errors/platform-failure-v0.1.schema.json",
  "title": "Luzione Platform Failure v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "domain", "class", "retry", "severity", "code", "safeMessage"],
  "properties": {
    "contractVersion": { "const": "luzione-platform-failure/v1" },
    "domain": { "enum": ["CLIENT", "AUTH", "POLICY", "DATA", "DEPENDENCY", "MODEL", "TOOL", "WORKFLOW", "PLATFORM"] },
    "class": { "enum": ["INVALID", "DENIED", "CONFLICT", "TIMEOUT", "UNAVAILABLE", "RATE_LIMITED", "CORRUPT", "INDETERMINATE", "UNKNOWN"] },
    "retry": { "enum": ["NEVER", "IMMEDIATE", "BACKOFF", "RECONCILE_FIRST", "HUMAN"] },
    "severity": { "enum": ["INFO", "DEGRADED", "ERROR", "CRITICAL"] },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" },
    "safeMessage": { "type": "string", "minLength": 1, "maxLength": 1000 }
  }
}
