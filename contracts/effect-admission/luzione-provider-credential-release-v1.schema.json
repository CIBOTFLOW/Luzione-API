{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.luzione.com/contracts/effect-admission/luzione-provider-credential-release-v1.schema.json",
  "title": "Luzione Provider Credential Release v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "credentialBindingId", "effectAdmissionRef", "executionIdentity", "preparedDispatchDigest", "releaseRef", "state"],
  "properties": {
    "contractVersion": { "const": "luzione-provider-credential-release/v1" },
    "credentialBindingId": { "$ref": "#/$defs/token" },
    "effectAdmissionRef": { "type": "string", "pattern": "^effect-admission:[a-f0-9]{64}$" },
    "executionIdentity": { "type": "string", "pattern": "^effect-execution:[a-f0-9]{64}$" },
    "preparedDispatchDigest": { "$ref": "#/$defs/digest" },
    "releaseRef": { "type": "string", "pattern": "^credential-release:[a-f0-9]{64}$" },
    "state": { "enum": ["NO_CREDENTIAL_REQUIRED", "RELEASED"] }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,511}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
