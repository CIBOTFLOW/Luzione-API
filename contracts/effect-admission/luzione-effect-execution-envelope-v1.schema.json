{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.luzione.com/contracts/effect-admission/luzione-effect-execution-envelope-v1.schema.json",
  "title": "Luzione Effect Execution Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["actor", "admissionCheckpoint", "authorityRef", "contractVersion", "credentialBindingId", "destination", "effectAdmissionRef", "effectAuthority", "effectClass", "executionEnvelopeRef", "executionIdentity", "killVersion", "operationKey", "originatingEnvelopeRef", "preparedDispatchDigest", "provider", "sourcePayloadHash", "tenantId"],
  "properties": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "actorType"],
      "properties": {
        "actorId": { "$ref": "#/$defs/token" },
        "actorType": { "enum": ["service", "system", "user", "agent"] }
      }
    },
    "admissionCheckpoint": { "enum": ["PROVIDER_PRE_EXECUTE", "SULTAN_EXECUTE"] },
    "authorityRef": { "$ref": "#/$defs/token" },
    "contractVersion": { "const": "luzione-effect-execution-envelope/v1" },
    "credentialBindingId": { "$ref": "#/$defs/token" },
    "destination": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$", "maxLength": 190 },
    "effectAdmissionRef": { "type": "string", "pattern": "^effect-admission:[a-f0-9]{64}$" },
    "effectAuthority": { "const": "SANDBOX_ONLY" },
    "effectClass": { "enum": ["EXTERNAL_EFFECT", "NO_EFFECT", "REVERSIBLE_INTERNAL"] },
    "executionEnvelopeRef": { "type": "string", "pattern": "^effect-envelope:[a-f0-9]{64}$" },
    "executionIdentity": { "type": "string", "pattern": "^effect-execution:[a-f0-9]{64}$" },
    "killVersion": { "type": "string", "pattern": "^kill:[a-f0-9]{64}$" },
    "operationKey": { "$ref": "#/$defs/token" },
    "originatingEnvelopeRef": { "$ref": "#/$defs/token" },
    "preparedDispatchDigest": { "$ref": "#/$defs/digest" },
    "provider": { "$ref": "#/$defs/token" },
    "sourcePayloadHash": { "$ref": "#/$defs/digest" },
    "tenantId": { "$ref": "#/$defs/token" }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,511}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
