# Canonical Luzione Postgres connection. Server only; never prefix with NEXT_PUBLIC_.
DATABASE_URL=

# Must be set to production in Vercel production.
APP_ENV=development

# Fail-closed mutation gate. Keep false until the database, auth and recovery path are verified.
LUZIONE_API_MUTATIONS_ENABLED=false

# Server-to-server token for Luzione UI and Sultan OS. Use a high-entropy encrypted Vercel secret.
LUZIONE_API_SERVICE_TOKEN=

# HMAC secret used by the extracted P111 continuation contract.
PLATFORM_CONTINUATION_SECRET=

# Optional Supabase values for later JWT verification and administrative API use.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
