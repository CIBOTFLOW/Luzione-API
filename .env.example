# Canonical Luzione Postgres connection. Server only; never prefix with NEXT_PUBLIC_.
DATABASE_URL=

# Optional Supabase Postgres CA PEM. When present, the API verifies the database
# certificate and hostname. Encode line breaks as \n when entered in Vercel.
DATABASE_CA_CERT=

# Must be set to production in Vercel production.
APP_ENV=development

# Fail-closed mutation gate. Keep false until the database, auth and recovery path are verified.
LUZIONE_API_MUTATIONS_ENABLED=false

# Exact comma-separated tenant IDs admitted to the Lead/Commercial Case dark path.
# An empty value keeps every domain command tenant disabled even when the global switch is true.
LUZIONE_API_DOMAIN_COMMAND_TENANTS=

# Narrow internal read-model/projection writes. This never authorizes Shopify,
# email, document publication, customer send, payment, or other external effects.
# It requires exact true, the global mutation gate, DB + service auth, and exact
# tenant/source admission. Empty allowlists keep every projection write disabled.
LUZIONE_API_INTERNAL_PROJECTIONS_ENABLED=false
LUZIONE_API_INTERNAL_PROJECTION_TENANTS=
LUZIONE_API_INTERNAL_PROJECTION_SOURCES=

# Default-off ONBOARD-CORE-01 internal persistence. This authorizes only the
# exact admitted tenants and never authorizes provider, credential, or hosted effects.
LUZIONE_API_ONBOARDING_CORE_ENABLED=false
LUZIONE_API_ONBOARDING_CORE_TENANTS=

# Default-off connector validation cone. This can reach only sandbox.echo and
# additionally requires the existing sandbox adapter tenant/destination gates.
LUZIONE_API_CONNECTOR_SYNC_VALIDATIONS_ENABLED=false
LUZIONE_API_CONNECTOR_SYNC_VALIDATION_TENANTS=

# Server-to-server token for Luzione UI and Sultan OS. Use a high-entropy encrypted Vercel secret.
LUZIONE_API_SERVICE_TOKEN=

# HMAC secret used by the extracted P111 continuation contract.
PLATFORM_CONTINUATION_SECRET=

# Optional Supabase values for later JWT verification and administrative API use.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
