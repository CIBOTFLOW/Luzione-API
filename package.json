{
  "name": "luzione-api",
  "version": "0.1.0",
  "private": true,
  "description": "Luzione's deterministic business platform, API and restricted operations console.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/tests/*.test.ts src/modules/*/tests/*.test.ts scripts/*.test.mjs",
    "test:security-posture": "node --import tsx --test src/lib/tests/*.test.ts src/modules/security-posture/tests/*.test.ts",
    "test:load:pilot": "node scripts/pilot-load-test.mjs",
    "db:migrate": "node scripts/run-platform-migrations.mjs",
    "db:migrate:dry-run": "node scripts/run-platform-migrations.mjs --dry-run",
    "release:manifest:prepare": "node scripts/platform-release-manifest.mjs prepare",
    "release:manifest:sign": "node scripts/platform-release-manifest.mjs sign",
    "release:manifest:verify": "node scripts/platform-release-manifest.mjs verify --production",
    "test:release-manifest": "node --test scripts/platform-release-manifest.test.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "compliance:verify": "node scripts/verify-compliance.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "16.3.3",
    "pg": "8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "20.19.25",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.1.14",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
