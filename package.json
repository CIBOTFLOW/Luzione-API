{
  "name": "luzione-api",
  "version": "0.1.0",
  "private": true,
  "description": "Luzione's deterministic business platform, API and restricted operations console.",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/tests/*.test.ts src/modules/*/tests/*.test.ts",
    "test:a02-contracts": "node --import tsx --test src/modules/shared-contract-drafts/tests/*.test.ts",
    "test:core-contracts": "node --import tsx --test src/modules/luzione-core-contracts/tests/*.test.ts",
    "contracts:generate:seed-product": "node scripts/generate-seed-product-contract-schema.mjs",
    "test:core02-inventory": "node --import tsx --test src/modules/core-02-inventory/tests/*.test.ts",
    "test:ops-contracts": "node --import tsx --test src/modules/operations-evidence-contracts/tests/*.test.ts",
    "test:onboard-core": "node --import tsx --test src/modules/onboard-core/tests/*.test.ts",
    "test:effect-admission": "node --import tsx --test src/modules/effect-admission/tests/*.test.ts src/modules/production-convergence/tests/provider-runtime.test.ts src/modules/sultan-agent-gateway/tests/sultan-agent-gateway.test.ts",
    "test:connector-revocation": "node --import tsx --test src/modules/connector-revocation/tests/*.test.ts",
    "test:seed-project-publication": "node --import tsx --test src/modules/seed-project-publication/tests/*.test.ts",
    "test:seed-procurement": "node --import tsx --test src/modules/seed-procurement/tests/*.test.ts",
    "test:security-posture": "node --import tsx --test src/lib/tests/*.test.ts src/modules/security-posture/tests/*.test.ts",
    "proof:a01-readiness": "bash scripts/validation/run-a01-readiness-rehearsal.sh",
    "proof:a02-contracts": "bash scripts/validation/run-a02-contract-draft-rehearsal.sh",
    "proof:onboard-core-blueprints": "bash scripts/validation/run-onboard-core-blueprint-mandate-proof.sh",
    "proof:onboard-core-imports": "bash scripts/validation/run-onboard-core-import-proof.sh",
    "proof:onboard-core-connector": "bash scripts/validation/run-onboard-core-connector-proof.sh",
    "proof:effect-admission": "bash scripts/validation/run-effect-admission-proof.sh",
    "proof:connector-revocation": "bash scripts/validation/run-connector-revocation-proof.sh",
    "proof:seed-project-publication": "bash scripts/validation/run-seed-project-publication-a2-proof.sh",
    "proof:seed-procurement": "bash scripts/validation/run-seed-procurement-a3-proof.sh",
    "proof:sultan-stage5": "bash scripts/validation/run-sultan-stage5-disposable-proof.sh",
    "test:taxonomy": "node --import tsx --test src/modules/platform-testing/tests/taxonomy.test.ts",
    "performance:local": "node --import tsx scripts/run-http-performance-profile.ts",
    "worker:providers": "node --import tsx scripts/run-provider-worker.ts",
    "evidence:production": "node --import tsx scripts/validate-production-convergence-evidence.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "compliance:verify": "node scripts/verify-compliance.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "16.3.4",
    "pg": "8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "20.19.25",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.1.14",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
